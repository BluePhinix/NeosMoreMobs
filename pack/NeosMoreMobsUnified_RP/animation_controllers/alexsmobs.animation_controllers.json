{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.alexsmobs.ground": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "walk": "query.modified_move_speed > 0.05"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed <= 0.05"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.flyer": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "fly": "!query.is_on_ground"
            },
            {
              "walk": "query.modified_move_speed > 0.05"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "fly": "!query.is_on_ground"
            },
            {
              "idle": "query.modified_move_speed <= 0.05"
            }
          ]
        },
        "fly": {
          "animations": [
            "fly"
          ],
          "transitions": [
            {
              "idle": "query.is_on_ground"
            }
          ]
        }
      }
    },
    "controller.animation.alexsmobs.attack": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "attack": "query.is_delayed_attacking == 1"
            }
          ]
        },
        "attack": {
          "animations": [
            "attack"
          ],
          "transitions": [
            {
              "default": "query.is_delayed_attacking == 0"
            }
          ]
        }
      }
    }
  }
}